{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(cat | jq -r '.tool_input.file_path // empty'); if [ -n \"$FILE\" ] && echo \"$FILE\" | grep -q '.ts$'; then npx tsc --noEmit 2>&1 || true; fi",
            "timeout": 30,
            "statusMessage": "Type-checking TypeScript..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm start:*)",
      "Bash(npm install:*)",
      "Bash(npx tsc:*)",
      "Bash(npx @modelcontextprotocol/inspector:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(ssh:*)",
      "Bash(rsync:*)",
      "Bash(bash sync.sh:*)",
      "Read(.env)",
      "Read(data/api-keys.json)",
      "Read(CLAUDE.local.md)"
    ]
  }
}
